FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      k;
}


dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 1e-09;

boundaryField
{
    lowerWall
    {
        type            kqRWallFunction;
        value           $internalField;
    }
    upperWall
    {
        type            kqRWallFunction;
        value           $internalField;
    }
    front
    {
        type            cyclic;
    }
    back
    {
        type            cyclic;
    }
    defaultFaces
    {
        type            empty;
    }
}